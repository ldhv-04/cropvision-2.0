{
  "name": "@cropvision/desktop",
  "version": "2.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "test": "pnpm rebuild:node && vitest run",
    "typecheck": "tsc -p .",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -m ../..",
    "rebuild:node": "pnpm --workspace-root rebuild better-sqlite3",
    "e2e": "pnpm build && pnpm rebuild:electron && node e2e/desktop.e2e.mjs",
    "package:linux": "pnpm build && electron-builder --linux dir",
    "package:win": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.6",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.8",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cropvision/domain": "workspace:*",
    "@cropvision/schema": "workspace:*",
    "@cropvision/sync-protocol": "workspace:*",
    "@electron/rebuild": "^4.2.1",
    "@tanstack/react-query": "^5.105.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "maplibre-gl": "^6.16.0",
    "playwright-core": "^1.64.1",
    "pmtiles": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7",
    "zustand": "^5.0.16"
  },
  "description": "CropVision 2.0 desktop workstation",
  "author": "CropVision",
  "build": {
    "appId": "vn.cropvision.desktop",
    "productName": "CropVision",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "executableName": "cropvision"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "npmRebuild": true
  }
}

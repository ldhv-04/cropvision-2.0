{
  "$schema": "https://tr.designtokens.org/format/",
  "id": "agri-command-dark",
  "name": "Agri Command Dark",
  "description": "Desktop default: deep slate + forest emerald + rust telemetry (GIS command center).",
  "order": 1,
  "scheme": "dark",
  "contrastTargets": { "text": 4.5, "onFill": 4.5, "nonText": 3 },
  "shadcn": {
    "background": "#0B0F17",
    "foreground": "#F8FAFC",
    "card": "#111622",
    "card-foreground": "#F8FAFC",
    "popover": "#151C2C",
    "popover-foreground": "#F8FAFC",
    "primary": "#16A34A",
    "primary-foreground": "#052E16",
    "secondary": "#1E293B",
    "secondary-foreground": "#E2E8F0",
    "muted": "#161F30",
    "muted-foreground": "#94A3B8",
    "accent": "#1E293B",
    "accent-foreground": "#F8FAFC",
    "destructive": "#EF4444",
    "destructive-foreground": "#FFFFFF",
    "border": "#1E293B",
    "input": "#1E293B",
    "ring": "#22C55E",
    "radius": "0.375rem"
  },
  "telemetry": {
    "healthy-fill": "#22C55E",
    "healthy-bg": "rgba(34, 197, 94, 0.12)",
    "healthy-border": "rgba(34, 197, 94, 0.40)",
    "warning-fill": "#F59E0B",
    "warning-bg": "rgba(245, 158, 11, 0.12)",
    "warning-border": "rgba(245, 158, 11, 0.40)",
    "critical-fill": "#EF4444",
    "critical-bg": "rgba(239, 68, 68, 0.15)",
    "critical-border": "rgba(239, 68, 68, 0.50)",
    "hydraulic-fill": "#3B82F6",
    "hydraulic-bg": "rgba(59, 130, 246, 0.15)",
    "hydraulic-border": "rgba(59, 130, 246, 0.50)"
  }
}

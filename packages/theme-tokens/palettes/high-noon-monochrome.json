{
  "$schema": "https://tr.designtokens.org/format/",
  "id": "high-noon-monochrome",
  "name": "High Noon Monochrome",
  "description": "Mobile extreme-glare override: pure black/white + hazard red/amber. Values are an assumption (A-UI-1): the plan names the intent but gives no hex codes.",
  "order": 3,
  "scheme": "light",
  "contrastTargets": { "text": 14, "onFill": 4.5, "nonText": 3 },
  "shadcn": {
    "background": "#FFFFFF",
    "foreground": "#000000",
    "card": "#FFFFFF",
    "card-foreground": "#000000",
    "popover": "#FFFFFF",
    "popover-foreground": "#000000",
    "primary": "#000000",
    "primary-foreground": "#FFFFFF",
    "secondary": "#E5E5E5",
    "secondary-foreground": "#000000",
    "muted": "#F2F2F2",
    "muted-foreground": "#1A1A1A",
    "accent": "#FFD600",
    "accent-foreground": "#000000",
    "destructive": "#B00000",
    "destructive-foreground": "#FFFFFF",
    "border": "#000000",
    "input": "#000000",
    "ring": "#000000",
    "radius": "0.25rem"
  },
  "telemetry": {
    "healthy-fill": "#005C1F",
    "healthy-bg": "#FFFFFF",
    "healthy-border": "#000000",
    "warning-fill": "#FFD600",
    "warning-bg": "#FFFFFF",
    "warning-border": "#000000",
    "critical-fill": "#B00000",
    "critical-bg": "#FFFFFF",
    "critical-border": "#000000",
    "hydraulic-fill": "#0033A0",
    "hydraulic-bg": "#FFFFFF",
    "hydraulic-border": "#000000"
  }
}

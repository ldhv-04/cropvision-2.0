{
  "$schema": "https://tr.designtokens.org/format/",
  "id": "tactical-daylight",
  "name": "Tactical Daylight",
  "description": "Mobile default: warm alabaster + high-contrast ink + bold borders for direct sunlight.",
  "order": 2,
  "scheme": "light",
  "contrastTargets": { "text": 10, "onFill": 4.5, "nonText": 3 },
  "shadcn": {
    "background": "#FAF9F5",
    "foreground": "#090D16",
    "card": "#FFFFFF",
    "card-foreground": "#090D16",
    "popover": "#FFFFFF",
    "popover-foreground": "#090D16",
    "primary": "#0F3D26",
    "primary-foreground": "#FFFFFF",
    "secondary": "#E2E8F0",
    "secondary-foreground": "#0F172A",
    "muted": "#F1F0EC",
    "muted-foreground": "#334155",
    "accent": "#DCFCE7",
    "accent-foreground": "#0F3D26",
    "destructive": "#DC2626",
    "destructive-foreground": "#FFFFFF",
    "border": "#94A3B8",
    "input": "#64748B",
    "ring": "#0F3D26",
    "radius": "0.5rem"
  },
  "telemetry": {
    "healthy-fill": "#15803D",
    "healthy-bg": "#DCFCE7",
    "healthy-border": "#166534",
    "warning-fill": "#B45309",
    "warning-bg": "#FEF3C7",
    "warning-border": "#D97706",
    "critical-fill": "#B91C1C",
    "critical-bg": "#FEE2E2",
    "critical-border": "#DC2626",
    "hydraulic-fill": "#1D4ED8",
    "hydraulic-bg": "#DBEAFE",
    "hydraulic-border": "#2563EB"
  }
}
